# Media stays out of git — keep source footage and renders local or in Drive
input/*
output/*
!input/.gitkeep
!output/.gitkeep
*.mp4
*.mov
*.m4v
*.mkv
*.webm
*.wav
*.mp3
*.m4a
.DS_Store

# HyperFrames: renders and local working state
ads/*/renders/
ads/*/.hyperframes/
ads/*/node_modules/

# Keep the sound effects bundled with the HyperFrames skills
!.claude/skills/**/*.mp3
