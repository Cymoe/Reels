# Media stays out of git — keep source footage and renders local or in Drive
input/*
output/*
!input/.gitkeep
!output/.gitkeep
*.mp4
*.mov
*.m4v
*.mkv
*.webm
*.wav
*.mp3
*.m4a
.DS_Store

# Remotion: keep the small template sample so a fresh clone renders out of the box
!remotion/public/sample-video.mp4
